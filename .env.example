# =============================================================================
# AdLens Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# --- OpenAI API Key (required for production ASR and vision) ---
# Leave blank to use mock/faster-whisper mode for development
OPENAI_API_KEY=

# =============================================================================
# Provider selection
# =============================================================================

# ASR backend: whisper_api | faster_whisper | mock
# - whisper_api: Hosted Whisper (requires OPENAI_API_KEY). Best accuracy.
# - faster_whisper: Local model (no API key needed). Downloads ~150MB on first use.
# - mock: Deterministic stub for development without any AI.
ADLENS_ASR_PROVIDER=mock

# Vision backend: gpt4o_mini | mock
# - gpt4o_mini: GPT-4o-mini vision (requires OPENAI_API_KEY). ~$0.000425/frame.
# - mock: Deterministic stub.
ADLENS_VISION_PROVIDER=mock

# =============================================================================
# Frame sampling
# =============================================================================

# Strategy: uniform | adaptive | keyframe
# - adaptive: Recommended. Dense near scene cuts, sparse elsewhere.
# - uniform: Simple fixed FPS. Good baseline.
# - keyframe: Extract I-frames only. Least redundancy but unpredictable.
ADLENS_SAMPLING_STRATEGY=adaptive

# Frames per second for uniform strategy
ADLENS_SAMPLE_FPS=1.0

# Hard cap on total frames per video (cost guard for long videos)
ADLENS_MAX_FRAMES_PER_VIDEO=300

# =============================================================================
# Scene detection
# =============================================================================

# PySceneDetect ContentDetector threshold (lower = more sensitive)
# 27.0 is the default; try 20.0 for more cuts, 35.0 for fewer
ADLENS_SCENE_THRESHOLD=27.0

# =============================================================================
# Signal fusion weights (must be positive; auto-normalized to sum to 1.0)
# =============================================================================

ADLENS_FUSION_AUDIO_WEIGHT=0.35
ADLENS_FUSION_VISUAL_WEIGHT=0.30
ADLENS_FUSION_OCR_WEIGHT=0.20
ADLENS_FUSION_SCENE_WEIGHT=0.15

# =============================================================================
# Segmentation
# =============================================================================

# Minimum fused score to flag a window as an ad candidate (0.0–1.0)
ADLENS_AD_SCORE_THRESHOLD=0.40

# Minimum segment duration — shorter segments are discarded as noise (seconds)
ADLENS_MIN_SEGMENT_DURATION_S=1.0

# Maximum gap between candidate windows to bridge when merging (seconds)
ADLENS_MAX_GAP_S=3.0

# =============================================================================
# Infrastructure
# =============================================================================

# Directory for temporary files (downloads, extracted frames, audio)
ADLENS_WORK_DIR=./workdir

# GPT-4o-mini image detail level: low (cheaper) | high (more accurate)
# low: ~$0.000425/frame   high: ~$0.0055/frame
ADLENS_VISION_DETAIL=low

# Number of frames per GPT-4o-mini API call (batching reduces call count)
ADLENS_VISION_BATCH_SIZE=5
